# prod-error-autofix — copy to .env and fill in. `.env` is gitignored; keep it chmod 600.
#
#   cp .env.example .env && chmod 600 .env
#   bun run bin/autofix.ts doctor      # tells you what is still missing
#
# Only the two REQUIRED keys have no default. Everything else is tuning; the value shown
# is what the code uses when the key is absent, so an empty .env is a working .env.


# ---- REQUIRED -----------------------------------------------------------------------

# Bot token of the Slack app that posts the prod-error alerts.
#
# The alerting app and this daemon must be the SAME Slack app. Verified 2026-07-30: alerts
# in the channel carry this bot's own user id, so "is this message from us" cannot be
# answered by comparing user ids — the daemon remembers the ts of what it wrote instead.
# Two separate apps would make its own replies look like new alerts.
#
# Scopes: channels:history (or groups:history for a private channel), chat:write.
SLACK_BOT_TOKEN=xoxb-

# Channel the alerts land in. Right-click the channel → Copy link; the id is the C… part.
SLACK_ERROR_CHANNEL_ID=C

# ---- Where things live --------------------------------------------------------------

# Parent directory holding a checkout of every app repo in `src/registry.ts`.
# Default only makes sense inside the second-brain layout; set it explicitly anywhere else.
# AUTOFIX_REPOS_ROOT=/Users/you/code/avada

# State DB, worktrees, job evidence and the daemon log.
# AUTOFIX_CACHE_ROOT=~/.cache/prod-autofix
# AUTOFIX_STATE_DB=<cache>/state.db

# What the agent stages are taught. Ships with the repo; LEARN writes back into it.
# AUTOFIX_BRAIN_ROOT=<repo>/brain

# `claude` is looked up on PATH, then ~/.local/bin/claude. Override for an odd install.
# AUTOFIX_CLAUDE_BIN=/usr/local/bin/claude


# ---- Transport ----------------------------------------------------------------------

# With an app-level token the daemon uses Socket Mode; without one it polls
# conversations.history, which the bot token alone covers. Polling is the tested path.
# SLACK_APP_TOKEN=xapp-
# AUTOFIX_TRANSPORT=poll          # poll | socket — forced to poll if no app token
# AUTOFIX_POLL_INTERVAL_MS=60000


# ---- Caps. These are what stop a bad night from opening thirty merge requests. -------

# AUTOFIX_MAX_CONCURRENT_JOBS=2
# AUTOFIX_MR_PER_HOUR=5
# AUTOFIX_MR_PER_REPO_PER_DAY=3
# AUTOFIX_MAX_FIX_ATTEMPTS=3
# AUTOFIX_REPLY_COOLDOWN_MS=86400000     # one reply per fingerprint per 24h

# Off since 2026-08-19. The daemon still triages and still replies in the
# thread; it stops opening MRs, because 58 were sitting unreviewed and an MR
# nobody reads is worse than no MR. Audit MRs are the reviewed lane now.
# AUTOFIX_FIX_ENABLED=false


# ---- Models. analyze and security block merge requests; do not economise on them. ----

# AUTOFIX_ANALYZE_MODEL=claude-opus-5
# AUTOFIX_FIX_MODEL=claude-sonnet-5
# AUTOFIX_LEARN_MODEL=claude-haiku-4-5-20251001
# AUTOFIX_SECURITY_MODEL=claude-opus-5


# ---- Timeouts ------------------------------------------------------------------------

# AUTOFIX_ANALYZE_TIMEOUT_MS=480000      # per round
# AUTOFIX_FIX_TIMEOUT_MS=720000
# AUTOFIX_SECURITY_TIMEOUT_MS=360000
# AUTOFIX_LEARN_TIMEOUT_MS=180000
# AUTOFIX_JEST_TIMEOUT_MS=1200000
# AUTOFIX_GCLOUD_TIMEOUT_MS=120000
# AUTOFIX_STALE_JOB_MS=5400000           # a job still `analyzing` past this lost its process


# ---- Behaviour -----------------------------------------------------------------------

# AUTOFIX_LOG_WINDOW_MS=900000           # log window either side of the alert
# AUTOFIX_ANALYZE_MAX_ROUNDS=5
# AUTOFIX_BRAIN_TOKEN_BUDGET=6000        # `autofix brain budget` fails when a slice exceeds it
# AUTOFIX_VERIFY_INTERVAL_MS=21600000    # re-measure shipped fixes every 6h; 0 disables


# ---- Optional: Telegram notification when an MR opens --------------------------------
# Both halves or neither. Missing means no notifying, which is degraded, never a failure —
# the Slack thread is the record.

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_THREAD_ID=
