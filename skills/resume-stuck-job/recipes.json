{
  "seo-bulk-fix": {
    "app": "SEO",
    "project": "avada-seo",
    "label": "Bulk AI Fix — fix chain (scores products)",
    "collection": "bulkFixJobs",
    "itemsSubcollection": "products",
    "itemQueueSource": "subcollection",
    "jobStatusField": "status",
    "jobActiveStatuses": ["processing"],
    "jobTerminalStatuses": ["done", "cancelled", "error"],
    "itemStatusField": "status",
    "itemInProgressStatuses": ["queued", "fixing_keyword", "fixing_related_keyword", "rescoring", "fixing_issues"],
    "itemPendingStatuses": ["pending"],
    "itemTerminalStatuses": ["done", "error", "skipped"],
    "itemRestartStatus": "queued",
    "itemErrorStatus": "error",
    "itemErrorField": "error",
    "failCounterFields": ["completed", "failed"],
    "jobDoneStatus": "done",
    "staleMinutes": 15,
    "shopFieldOnJob": "shopID",
    "topic": "bulkAuditFixProduct",
    "payloadTemplate": {"bulkJobId": "$JOB", "productId": "$ITEM", "shopID": "$SHOP"},
    "mutatesShopify": false,
    "source": "packages/functions/src/services/bulkAuditFix/productWorker.js (dispatchNextProduct), handlers/pubsub/subscribeBulkAuditFixProduct.js",
    "notes": "Fix/score chain, no Shopify writes (only Firestore + AI credits). FAL-206: subscriber catch+return swallows errors, so a throw mid-item kills the chain silently — nothing retries. Re-running a QUEUED item is idempotent (credits charged only at item end; a half-done item charged nothing)."
  },
  "seo-bulk-fix-apply": {
    "app": "SEO",
    "project": "avada-seo",
    "label": "Bulk AI Fix — APPLY chain (pushes fixes to Shopify)",
    "collection": "bulkFixJobs",
    "itemsSubcollection": "products",
    "itemQueueSource": "jobField:applyProductIds",
    "jobStatusField": "applyStatus",
    "jobActiveStatuses": ["processing"],
    "jobTerminalStatuses": ["done"],
    "itemStatusField": "applyStatus",
    "itemInProgressStatuses": ["queued", "applying"],
    "itemPendingStatuses": ["pending"],
    "itemTerminalStatuses": ["applied", "error"],
    "itemRestartStatus": "queued",
    "itemErrorStatus": "error",
    "itemErrorField": "applyError",
    "failCounterFields": ["applyFailedCount"],
    "jobDoneStatus": "done",
    "staleMinutes": 15,
    "shopFieldOnJob": "shopID",
    "topic": "bulkAuditFixApplyProduct",
    "payloadTemplate": {"bulkJobId": "$JOB", "productId": "$ITEM", "shopID": "$SHOP"},
    "mutatesShopify": true,
    "source": "packages/functions/src/handlers/pubsub/subscribeBulkAuditFixApplyProduct.js (dispatchNextOrFinalise), subscribeBulkAuditFixApply.js",
    "notes": "Apply chain WRITES SEO fields to the merchant's Shopify store. Item queue = job.applyProductIds (the selected done-products), NOT every product. Re-running an item re-writes the same title/meta/handle/faqs values (idempotent overwrite). Only run apply resume when job.status is 'done' and applyStatus is 'processing'."
  }
}
