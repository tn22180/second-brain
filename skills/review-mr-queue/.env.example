# === skill review-mr-queue (falcon) — cấu hình ===
# Token Jira: nếu đã cấu hình cho skill `jira` cạnh bên thì KHÔNG cần điền lại ở đây
# (skill tự đọc ../jira/.env). Chỉ điền nếu muốn token riêng cho skill này.
#   cp .env.example .env
JIRA_TOKEN=

# (tuỳ chọn) Thư mục gốc chứa các repo clone — giúp skill quét nhanh & đúng chỗ khi map projectPath.
# Nhiều đường ngăn bằng dấu ":". Bỏ trống → skill tự quét các gốc phổ biến (~/Desktop/Workspace, ~/projects...).
# REVIEW_PROJECTS_ROOT=/Users/you/Workspace:/Users/you/code

# (tuỳ chọn) override nếu instance Jira đổi:
# JIRA_BASE_URL=https://space.avada.net
# JIRA_FIELD_MERGE_REQUEST=customfield_10800
# JIRA_FIELD_ASSIGNEES=customfield_10700
