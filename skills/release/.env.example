# === skill release (falcon) — cấu hình token ===
#
# ▸ CÁCH CHÍNH: đặt vào khối "env" của ~/.claude/settings.json
#     { "env": { "GITLAB_TOKEN": "glpat-…", "GITLAB_PROJECT_ID": "17456707" } }
#   Điền một lần, dùng cho MỌI skill, và KHÔNG mất khi plugin cập nhật.
#   chmod 600 ~/.claude/settings.json — file lưu văn bản thường.
#
# ▸ File .env này là FALLBACK, chỉ dùng khi bạn đang sửa repo team-ops local.
#   Mỗi bản plugin mới nằm ở thư mục riêng theo commit SHA → .env KHÔNG được mang sang,
#   nên cách này mất token mỗi lần update.
#     cp .env.example .env      # rồi điền, KHÔNG commit .env
#   scripts/fetch-gitlab-mrs.sh tìm .env cạnh chính nó (thư mục skill), KHÔNG phải ở cwd.
#   Biến môi trường luôn THẮNG file này (kể cả khi file có dòng rỗng).
#
# Chi tiết: docs/setup.md mục 5.

# GitLab → Settings → Access Tokens (scope: read_api)
GITLAB_TOKEN=

# ID số của project trên GitLab — xem ở trang chính project, dưới tên repo
# (vd Avada SEO Suite = 17456707)
GITLAB_PROJECT_ID=
